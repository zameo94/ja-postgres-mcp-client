# Copy to .env and adjust as needed. Real environment variables take precedence.
# Only the MCP server URL is required; the rest have development defaults.

# Application
JA_CLIENT_ENVIRONMENT=development
JA_CLIENT_LOG_LEVEL=INFO
JA_CLIENT_HOST=127.0.0.1
JA_CLIENT_PORT=8100

# MCP server: the separate ja-postgres-mcp project, reached over Streamable HTTP.
# It is started independently; this project never runs it.
JA_CLIENT_MCP_SERVER_URL=http://localhost:8000/mcp
JA_CLIENT_MCP_CONNECT_TIMEOUT=10
JA_CLIENT_MCP_TOOL_TIMEOUT=30

# Development fallback for the local LLM provider (settings are chosen in the UI).
JA_CLIENT_OLLAMA_BASE_URL=http://localhost:11434
