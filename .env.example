# Copy to .env and adjust as needed. Real environment variables take precedence.
# Only the MCP server URL is required; the rest have development defaults.

# Application
JA_CLIENT_ENVIRONMENT=development
JA_CLIENT_LOG_LEVEL=INFO
JA_CLIENT_HOST=127.0.0.1
JA_CLIENT_PORT=8100
# Force the uvicorn autoreloader (default: true in development). Set to false in Docker.
# JA_CLIENT_RELOAD=false

# MCP server: the separate ja-postgres-mcp project, reached over Streamable HTTP.
# It is started independently; this project never runs it.
JA_CLIENT_MCP_SERVER_URL=http://localhost:8000/mcp
JA_CLIENT_MCP_CONNECT_TIMEOUT=10
JA_CLIENT_MCP_TOOL_TIMEOUT=30

# LLM providers are configured here (server-side); the UI only selects which one.
# Local Ollama:
JA_CLIENT_OLLAMA_BASE_URL=http://localhost:11434
JA_CLIENT_OLLAMA_MODEL=

# External OpenAI-compatible API (recommended; selected by default):
JA_CLIENT_EXTERNAL_BASE_URL=
JA_CLIENT_EXTERNAL_MODEL=
JA_CLIENT_EXTERNAL_API_KEY=

# Server-side system prompt prepended to every chat turn (also used by the
# backend container). Uncomment and set to override the built-in default.
# JA_CLIENT_SYSTEM_PROMPT=

# Optional: restrict the injected schema context to one schema. If empty, the
# backend discovers all non-system schemas; if set, it tells the model this is
# the relevant schema (the discovery tools stay available either way).
# JA_CLIENT_SCHEMA=

# Docker Compose (ignored by the backend). Host ports the services are published
# on; native services use the same values. The Ollama overlay publishes on
# OLLAMA_HOST_PORT (default 11435) so it does not clash with a native Ollama on
# 11434. OLLAMA_MODEL is pulled by the container on first startup; leave it empty
# to pull a model manually.
BACKEND_PORT=8100
FRONTEND_PORT=3000
OLLAMA_HOST_PORT=11435
OLLAMA_MODEL=
